<!-- 个人中心：顶栏固定，中间滚动，底部导航固定 -->
<view class="page">
  <!-- 自定义顶栏：右侧设置齿轮，位置避开微信胶囊 -->
  <mine-navbar bind:setting="onSetting" />
  <scroll-view class="body" scroll-y enhanced show-scrollbar="{{false}}">
    <!-- 头像、昵称、手机号和田野会员标 -->
    <mine-profile name="{{profile.name}}" phone="{{profile.phone}}" badge="{{profile.badge}}" />
    <!-- 优惠券、积分、收藏 -->
    <mine-stats items="{{stats}}" bind:select="onStat" />
    <!-- 我的订单。待付款带红色数字，查看全部单独抛出 -->
    <mine-orders items="{{orders}}" bind:all="onAllOrders" bind:select="onOrder" />
    <!-- 农场直供会员开通条 -->
    <mine-member
      title="{{member.title}}"
      subtitle="{{member.subtitle}}"
      action="{{member.action}}"
      bind:open="onOpenMember"
    />
    <!-- 收货地址、我的收藏、联系客服、设置 -->
    <mine-menu items="{{menus}}" bind:select="onMenu" />
    <!-- 退出登录。确认后清掉登录态并回到登录页 -->
    <view class="logout" hover-class="logout-pressed" bindtap="onLogout">
      <text class="logout-text">退出登录</text>
    </view>
    <!-- 底部留白，避免最后一行贴住导航 -->
    <view class="bottom-space"></view>
  </scroll-view>
  <!-- 底部导航。当前页是我的，角标是购物车件数 -->
  <app-tab-bar current="mine" cart-count="{{cartCount}}" />
</view>
