<!-- 手机号登录。顶栏自己让出状态栏，下面按设计稿从上往下排 -->
<view class="page">
  <!-- 返回箭头和「手机号登录」 -->
  <phone-navbar title="{{copy.title}}" bind:back="onBack" />
  <!-- 田标、店名、未注册说明 -->
  <phone-brand name="{{brand.name}}" slogan="{{copy.slogan}}" logo="{{images.logo}}" />
  <!-- 区号、手机号、验证码 -->
  <phone-form
    dial="{{copy.dial}}"
    phone="{{phone}}"
    phone-placeholder="{{copy.phonePlaceholder}}"
    code-label="{{copy.codeLabel}}"
    code="{{code}}"
    code-placeholder="{{copy.codePlaceholder}}"
    send-label="{{sendLabel}}"
    bind:phoneinput="onPhoneInput"
    bind:codeinput="onCodeInput"
    bind:handleSendCode="handleSendCode"
  />
  <!-- 登录 -->
  <phone-submit label="{{copy.submit}}" bind:login="onSubmit" />
  <!-- 回到微信登录 -->
  <phone-back label="{{copy.back}}" bind:back="onBack" />
  <!-- 协议勾选。这一屏没有头像授权说明，hint 留空 -->
  <view class="agree">
    <login-agreement
      checked="{{agreed}}"
      lead="{{agreement.lead}}"
      agreement="{{agreement.agreement}}"
      join="{{agreement.join}}"
      privacy="{{agreement.privacy}}"
      hint=""
      bind:toggle="onToggleAgree"
      bind:open="onOpenDoc"
    />
  </view>
</view>
